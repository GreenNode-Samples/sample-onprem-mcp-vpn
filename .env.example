# Environment variables for the on-prem MCP server (local runs). Copy to `.env`: cp .env.example .env
# For the data-center deployment use infra/onprem/.env.example instead.

# [REQUIRED] API key(s) protecting /mcp. Several keys, comma-separated, allow zero-downtime rotation.
# Every key must be at least 32 characters. The value below is a placeholder that the server REJECTS: /mcp answers 503
# (and the startup log says why) until you replace it with the output of:  openssl rand -hex 32
# Not set -> /mcp answers 503 as well (fail-closed). When the server is reached through an MCP Gateway,
# store the SAME key in Access Control (API Key provider `onprem-mcp-key`).
MCP_API_KEYS=change-me-run-openssl-rand-hex-32

# LOCAL DEVELOPMENT ONLY. Opens /mcp when MCP_API_KEYS is empty. Never set this in a deployment.
# ALLOW_ANONYMOUS=true

# Listen port (default 8080) and bind address (default 0.0.0.0; an IPv4 address, for example 127.0.0.1).
# PORT=8080
# HOST=0.0.0.0

# SQLite database file; created and seeded with fictional demo data on first start.
# DB_PATH=data/erp.db

# Set to true ONLY when a reverse proxy you control (for example the Caddy TLS profile) is the only way to reach
# the server: the audit log then records the client address from the last X-Forwarded-For entry, but only for
# requests whose TCP peer is in TRUSTED_PROXIES.
# TRUST_FORWARDED_FOR=false
# Peers whose X-Forwarded-For is believed when TRUST_FORWARDED_FOR is true: IP addresses or CIDR networks,
# comma-separated (default: loopback).
# TRUSTED_PROXIES=127.0.0.1,::1
