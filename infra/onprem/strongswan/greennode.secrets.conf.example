# Copy to /etc/swanctl/conf.d/greennode.secrets.conf and set the real pre-shared key, then:
#   sudo chown root:root /etc/swanctl/conf.d/greennode.secrets.conf && sudo chmod 600 /etc/swanctl/conf.d/greennode.secrets.conf
# The PSK must be IDENTICAL on both sides: either the key you typed in the GreenNode console
# ("Used Your Pre-shared Key") or the key generated by GreenNode (shown on the VPN detail page).
# Generate your own with:  openssl rand -base64 36
secrets {
    ike-greennode {
        id-1 = 203.0.113.10          # GreenNode VPN public IP (the remote id) - example
        secret = "CHANGE_ME_PRE_SHARED_KEY"
    }
}
