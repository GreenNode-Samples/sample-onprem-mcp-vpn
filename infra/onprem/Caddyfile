# TLS reverse proxy for the MCP server (used only with `docker compose --profile tls`).
# CADDY_SITE is the IP or internal hostname from .env; it must match the host in the connector URL.
{
	# No public ACME certificates: this host is inside a private network.
	auto_https disable_redirects
}

https://{$CADDY_SITE}:8443 {
	# Certificate issued by Caddy's own internal CA. The MCP Gateway must trust that CA
	# (root: /data/caddy/pki/authorities/local/root.crt inside the caddy_data volume).
	# How a custom CA is supplied to a connector is not described in the public docs: verify with GreenNode.
	tls internal

	# Or use a certificate issued by your enterprise CA (mount ./certs in docker-compose.yml):
	# tls /certs/server.crt /certs/server.key

	# MCP_UPSTREAM defaults to the compose service name; the lab script sets it to <lan-ip>:8080.
	reverse_proxy {$MCP_UPSTREAM:mcp:8080} {
		# MCP streamable HTTP: forward data immediately, do not buffer
		flush_interval -1
	}
}
