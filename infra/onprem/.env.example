# Copy to `.env` (git-ignored) and lock it down:  cp .env.example .env && chmod 600 .env

# [REQUIRED] API key(s) protecting /mcp, comma-separated for zero-downtime rotation.
# Every key must be at least 32 characters. The value below is a placeholder that the server REJECTS: /mcp answers 503
# until you replace it with the output of:  openssl rand -hex 32
# Store the SAME value in Access Control (API Key provider `onprem-mcp-key`) on the GreenNode side.
MCP_API_KEYS=change-me-run-openssl-rand-hex-32

# Internal IP of THIS host that Docker publishes the plain HTTP port on (example). Never use 0.0.0.0 on a host with a
# public NIC. With the TLS profile use 127.0.0.1 so the plain port is not reachable from the network.
MCP_BIND_ADDR=192.168.10.20
MCP_PORT=8080

# Only used with `docker compose --profile tls` (Caddy in front of the server):
TLS_BIND_ADDR=192.168.10.20
TLS_PORT=8443
# IP or internal hostname the certificate is issued for (must match the connector URL host).
CADDY_SITE=192.168.10.20
# The audit log then records the client address from X-Forwarded-For (set by Caddy), only for requests that come
# from Caddy itself (docker-compose.yml sets TRUSTED_PROXIES). Enable ONLY with the TLS profile.
# TRUST_FORWARDED_FOR=true

# Image: built from the repo Dockerfile by default; or pull from vCR / an internal registry.
# MCP_IMAGE=vcr.vngcloud.vn/<repo>/onprem-mcp-server:v1
